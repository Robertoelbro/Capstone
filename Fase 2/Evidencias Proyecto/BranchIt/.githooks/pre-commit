#!/bin/sh
# Block private build/runtime files even after an accidental git add -f.
git diff --cached --name-only --diff-filter=ACMR | while IFS= read -r path; do
  case "/$path" in
    */.vercel/*|*/.env|*/.env.*)
      case "$path" in *.env.example) continue ;; esac
      echo "Commit bloqueado: archivo privado o temporal: $path" >&2
      echo "Retíralo del índice con git rm --cached; conserva el archivo local." >&2
      exit 1
      ;;
  esac
done
