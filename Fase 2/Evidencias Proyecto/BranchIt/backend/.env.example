DATABASE_URL=postgresql+psycopg2://USUARIO:CONTRASENA@localhost:5432/branchit
SECRET_KEY=
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Fernet: guardar fuera de Git; conservarla para poder descifrar postulaciones
DATA_ENCRYPTION_KEY=

# Solo backend. Clave de un proyecto Gemini Free con facturación desactivada.
GEMINI_API_KEY=

# Webpay Plus: solo integración; esta versión no permite cobros productivos.
# Configurar solo en el servidor; nunca usar nombres VITE_* para estas claves.
WEBPAY_COMMERCE_CODE=
WEBPAY_API_KEY=
WEBPAY_ENV=integration
WEBPAY_ENABLED=false
WEBPAY_RETURN_URL=
WEBPAY_FRONTEND_URL=

# Debe coincidir con el secreto privado del servicio de archivos del frontend.
MEDIA_SERVICE_SECRET=
